FROM ubuntu:24.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates git cmake make gcc g++ gcc-arm-none-eabi libnewlib-arm-none-eabi \
    libstdc++-arm-none-eabi-newlib python3 python3-venv nodejs npm pkg-config \
    && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 --branch 2.1.1 --recurse-submodules --shallow-submodules \
    https://github.com/raspberrypi/pico-sdk.git /opt/pico-sdk
RUN git config --global --add safe.directory /src
ENV PICO_SDK_PATH=/opt/pico-sdk
WORKDIR /src
